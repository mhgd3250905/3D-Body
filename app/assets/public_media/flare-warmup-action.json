    "id": "t-kneeling-scap-pushup",
    "name": {
      "zh": "跪姿肩胛俯卧撑",
      "en": "Kneeling Scapula Push-Up"
    },
    "purpose": "俯卧撑加推的入门版，膝盖跪着先把肩胛推地的劲儿找到",
    "category": "strength",
    "muscles": [
      "前锯肌",
