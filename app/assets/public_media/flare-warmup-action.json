    "cuesEn": [
      "Lock your elbows, only your shoulder blades move",
      "Hands right under your shoulders, knees planted, one straight slope from your knees to your head.",
      "Let your chest drop so your shoulder blades come together, then push the floor away until your upper back rounds slightly.",
      "Wait a second at the top, shoulders away from your ears, and keep your hips from bobbing."
    ],
    "commonErrors": [
      {
        "zh": "手肘跟着弯，变成跪姿俯卧撑",
        "en": "Bending your elbows and turning it into a kneeling push-up."
      },
      {
        "zh": "耸肩、头往前探",
        "en": "Shrugging and pushing your head forward."
      },
      {
        "zh": "屁股往后坐或者塌腰，靠腰动不是肩胛骨在动",
        "en": "Sitting your hips back or sagging your lower back, so your waist moves instead of your shoulder blades."
      }
    ],
    "cautionsEn": [
      "If your knees hurt on the floor, put a towel under them."
    ],
