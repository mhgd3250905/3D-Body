{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flare drill library",
  "type": "object",
  "required": [
    "meta",
    "groups",
    "drills"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "version",
        "tiers",
        "count"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "tiers": {
          "type": "object"
        },
        "note": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "section",
          "colour",
          "role"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "section": {
            "enum": [
              "support",
              "core",
              "legs"
            ]
          },
          "colour": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "drills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "A",
          "B",
          "C"
        ],
        "properties": {
          "A": {
            "type": "object",
            "required": [
              "id",
              "groupId",
              "tier",
              "tierLabel",
              "name",
              "nameEn",
              "equipment",
              "prescription",
              "cues",
              "mistake",
              "why",
              "difficulty",
              "image"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z-]+-[ABC]$"
              },
              "groupId": {
                "type": "string",
                "pattern": "^[a-z-]+$"
              },
              "tier": {
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              "tierLabel": {
                "enum": [
                  "徒手",
                  "家用器械",
                  "健身房"
                ]
              },
              "name": {
                "type": "string"
              },
              "nameEn": {
                "type": "string"
              },
              "equipment": {
                "type": "string"
              },
              "prescription": {
                "type": "string"
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "mistake": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "safety": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "image": {
                "type": "string",
                "pattern": "^img/.+\\.png$"
              }
            }
          },
          "B": {
            "type": "object",
            "required": [
              "id",
              "groupId",
              "tier",
              "tierLabel",
              "name",
              "nameEn",
              "equipment",
              "prescription",
              "cues",
              "mistake",
              "why",
              "difficulty",
              "image"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z-]+-[ABC]$"
              },
              "groupId": {
                "type": "string",
                "pattern": "^[a-z-]+$"
              },
              "tier": {
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              "tierLabel": {
                "enum": [
                  "徒手",
                  "家用器械",
                  "健身房"
                ]
              },
              "name": {
                "type": "string"
              },
              "nameEn": {
                "type": "string"
              },
              "equipment": {
                "type": "string"
              },
              "prescription": {
                "type": "string"
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "mistake": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "safety": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "image": {
                "type": "string",
                "pattern": "^img/.+\\.png$"
              }
            }
          },
          "C": {
            "type": "object",
            "required": [
              "id",
              "groupId",
              "tier",
              "tierLabel",
              "name",
              "nameEn",
              "equipment",
              "prescription",
              "cues",
              "mistake",
              "why",
              "difficulty",
              "image"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z-]+-[ABC]$"
              },
              "groupId": {
                "type": "string",
                "pattern": "^[a-z-]+$"
              },
              "tier": {
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              "tierLabel": {
                "enum": [
                  "徒手",
                  "家用器械",
                  "健身房"
                ]
              },
              "name": {
                "type": "string"
              },
              "nameEn": {
                "type": "string"
              },
              "equipment": {
                "type": "string"
              },
              "prescription": {
                "type": "string"
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "mistake": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "safety": {
                "type": [
                  "string",
