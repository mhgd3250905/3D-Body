* text=auto

# Vite preserves inline HTML newlines; avoid doubled CRs in generated scenes.
app/scene/index.html text eol=lf
app/assets/scene/index.html text eol=lf

# Keep exported poses and asset manifests byte-for-byte across platforms.
*.json -text
*.glb binary
*.bin binary
*.gz binary
*.png binary
*.jpg binary
*.zip binary

# Immutable v41 oracle hashes cover the original checkout bytes, including CRLF.
app/scene/source/v41-runtime/** -text

# Frozen motion review evidence is identified by byte hashes.
tools/motion-v42/releases/r12-evidence/** -text

# Frozen independent R13/R14 authoring and accepted review evidence.
tools/motion-v42-r13/** -text
tools/motion-v42-r14/** -text

# Frozen R15 authoring, preview and accepted review evidence use byte hashes.
tools/motion-v42-r15/** -text
