{"dur":8.991662288489888,"n":540,"phases":[{"id":"rear-support","name":"后侧支撑","detail":"长腿过前方","cap":"双手推地撑住身体，屈髋把开立的长腿抬过身体前方；腹部卷紧，臀中肌保持开腿。"},{"id":"first-transfer","name":"第一侧移重","detail":"单手接重","cap":"重量从双手移到单手：支撑侧三角肌、肱三头肌和前锯肌一起接住体重，腕屈肌稳住掌根；腹斜肌把骨盆转向侧面。"},{"id":"first-support","name":"第一侧支撑","detail":"高 V 开腿","cap":"单手撑起全身、身体侧立：支撑肩最吃力，肩袖护住肩关节；腹斜肌把髋撑高，臀中肌打开高 V 字腿。"},{"id":"first-pass","name":"第一侧换腿","detail":"准备回撑","cap":"身体转向正面，双腿像剪刀一样换位过前：屈髋肌和腹直肌把腿带到前方，内收肌控制两腿交错；另一只手准备回撑。"},{"id":"front-support","name":"前侧支撑","detail":"开腿扫后方","cap":"双手在身后撑地、胸口朝上：肱三头肌、三角肌和胸大肌像做臂屈伸一样顶住身体；双腿保持大开度，准备向后扫。"},{"id":"second-transfer","name":"第二侧移重","detail":"换手接重","cap":"换到另一只手单撑：支撑侧肩臂和前锯肌重新接住体重，腕屈肌稳住掌根；臀大肌带长腿从前方扫向后方。"},{"id":"second-support","name":"第二侧支撑","detail":"高 V 开腿","cap":"另一侧单手侧撑：支撑肩与肩袖承担全身重量；腹斜肌撑高骨盆，臀中肌保持高 V 开腿。"},{"id":"second-pass","name":"第二侧换腿","detail":"准备接圈","cap":"身体转回朝下，双腿扫过后方：臀大肌伸髋带腿，竖脊肌保持髋部高度，腹斜肌把身体旋回；另一只手准备落地接回下一圈。"}],"seg":[[0,0,0.650603],[1,0.667285,1.935126],[2,1.951808,3.086192],[3,3.102874,4.087119],[4,4.103801,4.937907],[5,4.954589,5.988881],[6,6.005563,7.123265],[7,7.139947,8.357742],[0,8.374424,8.991662]],"groups":[{"id":"deltoids","label":"三角肌","sec":"support"},{"id":"rotator-cuff","label":"肩袖肌群","sec":"support"},{"id":"triceps","label":"肱三头肌","sec":"support"},{"id":"forearms","label":"前臂 · 腕屈伸肌","sec":"support"},{"id":"serratus","label":"前锯肌","sec":"support"},{"id":"scapular","label":"斜方肌中下部 · 菱形肌","sec":"support"},{"id":"chest","label":"胸大肌","sec":"support"},{"id":"lats","label":"背阔肌","sec":"support"},{"id":"abs","label":"腹直肌（含深层腹横肌）","sec":"core"},{"id":"obliques","label":"腹斜肌","sec":"core"},{"id":"erectors","label":"竖脊肌","sec":"core"},{"id":"hip-flexors","label":"髋屈肌","sec":"core"},{"id":"glute-max","label":"臀大肌","sec":"legs"},{"id":"hip-abductors","label":"臀中肌 · 髋外展","sec":"legs"},{"id":"adductors","label":"内收肌群","sec":"legs"},{"id":"quadriceps","label":"股四头肌","sec":"legs"},{"id":"hamstrings","label":"腘绳肌","sec":"legs"}],"states":[[0,"both",[[2,"both"],